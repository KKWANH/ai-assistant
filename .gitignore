# dependencies
node_modules/
**/node_modules/
.venv/

# python leftovers
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
*cache/

# build output
apps/web/dist/
**/dist/
**/*.tsbuildinfo
**/.vite/

# runtime state
logs/
run/
data/
*.log
.ariadne/
**/.ariadne/

# env / secrets — never commit credentials
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
**/credentials*.json
.cloudflared/
id_rsa
id_rsa.*
*.secret

# private / local-only docs — internal notes, financial data, AI session
# instructions. Untracked today; ignore so `git add -A` can't leak them on a
# public push. Un-ignore individually if you decide to publish one.
/CLAUDE.md
/FEATURE_CHECKLIST.md
/LECTURE_PREP_DESIGN.md
/docs/REPORTED_ISSUES.md
/자산.md

# os
.DS_Store

# eval fixtures are intentionally named like real credentials so the
# safety harness has something to test. The contents are clearly
# labelled "FAKE-DO-NOT-USE"; force them into the repo so fresh
# clones can run `npm run eval:strategy`.
!apps/server/src/eval/fixtures/**/.ariadne/
!apps/server/src/eval/fixtures/**/.ariadne/**
!apps/server/src/eval/fixtures/**/credentials*.json
!apps/server/src/eval/fixtures/**/*.env

# User-promoted eval cases are per-user content (real workspace ids,
# real account names, real workspace paths). Keep them on the
# contributor's machine; never ship in the repo.
apps/server/src/eval/cases/user-promoted/
.ariadne/cache/

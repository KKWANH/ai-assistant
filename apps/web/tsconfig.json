{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "paths": {
      "@ariadne/shared": ["../../packages/shared/src/index.ts"],
      "@projects/*": ["../../projects/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../../projects/**/web.ts", "../../projects/**/types.ts", "../../projects/**/web/**/*.ts", "../../projects/**/web/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}

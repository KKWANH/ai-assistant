AIWS_ROOT=$HOME/.ai-workspace
AIWS_PORT=8765
AIWS_SERVER_PASSWORD=change-me-use-a-long-random-password
AIWS_MODELS=ollama
AIWS_MODEL_IDLE_TIMEOUT=1800
AIWS_LOG_DIR=$HOME/.ai-workspace/logs
AIWS_RUN_DIR=$HOME/.ai-workspace/run
AIWS_CLOUDFLARED_PROTOCOL=http2
AIWS_CLOUDFLARE_HEALTHCHECK=0
AIWS_KIMI_API_KEY=
MOONSHOT_API_KEY=
AIWS_KIMI_BASE_URL=https://api.moonshot.ai/v1
AIWS_KIMI_DEFAULT_MODEL=kimi-k2.6
AIWS_KIMI_MODELS=kimi-k2.5,kimi-k2.6,kimi-k2-thinking
AIWS_KIMI_THINKING=0
AIWS_GEMINI_API_KEY=
AIWS_GEMINI_DEFAULT_MODEL=gemini-2.5-flash-lite
AIWS_OPENAI_API_KEY=
AIWS_OPENAI_DEFAULT_MODEL=gpt-5.1-codex
AIWS_DEFAULT_PROVIDER=ollama
AIWS_DEFAULT_MODEL=qwen3:4b
AIWS_OLLAMA_BASE_URL=http://localhost:11434
AIWS_DAILY_USD_LIMIT=2
AIWS_MONTHLY_USD_LIMIT=20
AIWS_REQUIRE_CONFIRM_OVER_USD=0.25
AIWS_DISABLE_REMOTE_BY_DEFAULT=true
AIWS_MAX_ATTACHMENT_BYTES=31457280
AIWS_MAX_UPLOAD_BYTES=32505856
AIWS_MAX_WORKSPACE_ATTACHMENT_BYTES=2147483648
AIWS_STATUS_PATH=$HOME/.ai-workspace/runtime-status.json

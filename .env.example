# Ariadne environment — copy to .env and fill in what you use.
# Ports
ARIADNE_PORT=4319
ARIADNE_ADMIN_PORT=7459

# Active AI provider: anthropic | openai | gemini | moonshot | ollama | mock
ARIADNE_PROVIDER=mock

# API keys (only the active provider's key is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=

# Ollama (local models on this Mac) — no key needed, just a running ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Auth — admin account seeded on first boot if the accounts table is empty.
# Defaults: username=admin, password=ariadne (change before exposing via tunnel!)
ARIADNE_ADMIN_USER=admin
ARIADNE_ADMIN_PASSWORD=ariadne

# Web search — POST /api/search
# Priority: Tavily > Brave > keyless DuckDuckGo fallback (no key required).
# Leave both blank to use the DuckDuckGo fallback automatically.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Cloudflare named tunnel — set by `ops/setup-tunnel.sh <hostname>`.
# When both are set, the daemon serves a stable custom domain instead of an
# ephemeral *.trycloudflare.com URL. Leave blank for the quick tunnel.
ARIADNE_TUNNEL_NAME=
ARIADNE_TUNNEL_HOSTNAME=

{
  "name": "ariadne",
  "version": "0.1.0",
  "private": true,
  "description": "Ariadne — local-first AI workspace for traceable, repeatable work.",
  "license": "AGPL-3.0-or-later",
  "author": "Kwanho Kim",
  "repository": {
    "type": "git",
    "url": "https://github.com/KKWANH/ai-assistant.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "npm run build --workspace @ariadne/web",
    "check:bundle": "tsx scripts/check-bundle-budgets.ts",
    "gen:api": "node scripts/gen-api-inventory.mjs",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "npm run dev --workspace @ariadne/web",
    "start:server": "tsx apps/server/src/index.ts",
    "start:supervisor": "tsx apps/admin/src/supervisor.ts",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/server && tsc --noEmit -p apps/admin && tsc --noEmit -p apps/web",
    "eval:retrieval": "tsx apps/server/src/eval/runRetrievalEval.ts",
    "eval:retrieval:ci": "tsx apps/server/src/eval/runRetrievalEval.ts --ci",
    "eval:retrieval:promoted": "tsx apps/server/src/eval/runPromotedRetrievalEval.ts",
    "eval:strategy": "tsx apps/server/src/eval/runStrategyEval.ts",
    "eval:rag": "tsx apps/server/src/eval/runRagEval.ts",
    "eval:rag:ci": "tsx apps/server/src/eval/runRagEval.ts --use-db"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@types/node": "^22.18.13"
  }
}
